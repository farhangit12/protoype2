# Copy to .env.local for local runs. On Vercel, add the same names under
# Project → Settings → Environment Variables. Never commit real keys.

# --- Clerk (https://dashboard.clerk.com → API keys) ---
# Leave both empty to run in demo mode (no sign-in, one demo founder).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2hlZXJmdWwtc2hlcGhlcmQtMzM0MS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_MiUQQPCdCy01cdmG76SibN7JULgszhloHgxQuN08tr
